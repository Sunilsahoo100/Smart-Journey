# ── Required ────────────────────────────────────────────────────────────────
# Free Gemini API key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional: pin a specific Gemini model. By default the app uses
# "gemini-flash-latest" and falls back to other Flash models automatically.
# VITE_GEMINI_MODEL=gemini-flash-latest

# ── Optional: Google sign-in ────────────────────────────────────────────────
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Add http://localhost:5173 (and your deployed URL) to "Authorized JavaScript origins".
# Leave empty to use "Continue as guest" only.
VITE_GOOGLE_AUTH_CLIENT_ID=559856819546-vkn7g6aq3f1ptss67c0h0c2iatifgk54.apps.googleusercontent.com

# ── Optional: Firebase / Firestore cloud sync ───────────────────────────────
# Without these, trips are stored in the browser (localStorage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=travel-planner-438a0.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=travel-planner-438a0
VITE_FIREBASE_STORAGE_BUCKET=travel-planner-438a0.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1007281510870
VITE_FIREBASE_APP_ID=1:1007281510870:web:9f2b70c3cae43193a0ac77
