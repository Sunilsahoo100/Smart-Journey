# ── Required ────────────────────────────────────────────────────────────────
# Free Gemini API key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Optional: pin a specific Gemini model. By default the app uses
# "gemini-flash-latest" and falls back to other Flash models automatically.
# VITE_GEMINI_MODEL=gemini-flash-latest

# ── Firebase (sign-in + cloud sync) ─────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app config.
# Enable Authentication (Google + Anonymous) and Firestore, and publish
# firestore.rules. Without these values, the app runs in local-only guest mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=smart-journey-e48a9.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=smart-journey-e48a9
VITE_FIREBASE_STORAGE_BUCKET=smart-journey-e48a9.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=51884706054
VITE_FIREBASE_APP_ID=1:51884706054:web:ea47620ad358615ece7687
